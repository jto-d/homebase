generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider          = "prisma-pothos-types"
  generateDatamodel = "true"
}

// No `url` here — Prisma 7 moved it to prisma.config.ts (which reads DIRECT_URL
// for the CLI). The runtime connection comes from @prisma/adapter-neon in
// src/lib/prisma.ts, which reads DATABASE_URL.
datasource db {
  provider = "postgresql"
}

/// The unit of ownership for the entire app. Every domain model added later
/// scopes through `householdId`, never through a flat `userId` — see the
/// ownership convention in CLAUDE.md.
///
/// Capped at 2 members for v1. Created either solo (on a first sign-in with no
/// invite) or joined via a HouseholdInvite.
model Household {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  members      User[]
  invites      HouseholdInvite[]
  budgets      Budget[]
  transactions Transaction[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  /// Palette slug from src/lib/members.ts — the basis for every "whose is
  /// whose" badge in the app. Assigned at household creation (first member) or
  /// at join (second member takes the free slot); stable thereafter.
  color     String
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdInvites  HouseholdInvite[] @relation("CreatedBy")
  acceptedInvites HouseholdInvite[] @relation("AcceptedBy")

  budgets          Budget[]
  paidTransactions Transaction[]

  @@index([householdId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

/// Single-use, never expires. Consumed by flipping status PENDING -> ACCEPTED
/// with a conditional update, which is what makes "single use" race-safe.
model HouseholdInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  status           InviteStatus @default(PENDING)
  acceptedByUserId String?
  acceptedBy       User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([householdId])
  @@index([createdByUserId])
}

/// A per-person monthly spending target.
///
/// Unlike the rest of the app, `ownerId` is required rather than nullable: there
/// are no joint budgets in v1. A shared cost is handled by splitting the
/// transaction into both people's budgets instead. `householdId` is still the
/// query scope, and either member can read and edit the other's budgets.
model Budget {
  id        String   @id @default(cuid())
  name      String
  /// Applies to every month. There are no per-month overrides in v1.
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  splits TransactionSplit[]

  @@unique([ownerId, name])
  @@index([householdId])
}

/// A single real-world charge. Spend is never stored on a Budget — it is derived
/// by summing the splits below, which makes this table the only source of truth
/// and rules out the two writers disagreeing.
model Transaction {
  id        String   @id @default(cuid())
  merchant  String
  /// Date-only. Always read and write through `monthRange` in src/lib/budget.ts:
  /// local date getters slip a month at the boundary.
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Who paid. null = a joint account, so nobody is owed. Pure attribution — it
  /// has no bearing on which budget the money lands in, that is the splits' job.
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  splits TransactionSplit[]

  @@index([householdId, date])
}

/// One share of a transaction, filed against exactly one budget.
///
/// Invariant: a transaction has either zero splits (unfiled — it counts against
/// no budget) or splits summing exactly to its amount. Enforced in
/// `validateSplits`, and `setTransactionSplits` is the only way to write these.
///
/// No `householdId` of its own: a child row is always reached through its
/// transaction, which carries the scope, and is cascade-deleted with it.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: cascading would delete some of a transaction's splits
  /// and leave the survivors summing to less than its amount. `deleteBudget`
  /// refuses while splits reference the budget instead.
  budgetId      String
  budget        Budget      @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  amount        Decimal     @db.Decimal(10, 2)

  @@index([transactionId])
  @@index([budgetId])
}
