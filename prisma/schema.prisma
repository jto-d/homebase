generator client {
  provider = "prisma-client-js"
}

generator pothos {
  provider          = "prisma-pothos-types"
  generateDatamodel = "true"
}

// No `url` here — Prisma 7 moved it to prisma.config.ts (which reads DIRECT_URL
// for the CLI). The runtime connection comes from @prisma/adapter-neon in
// src/lib/prisma.ts, which reads DATABASE_URL.
datasource db {
  provider = "postgresql"
}

/// The unit of ownership for the entire app. Every domain model added later
/// scopes through `householdId`, never through a flat `userId` — see the
/// ownership convention in CLAUDE.md.
///
/// Capped at 2 members for v1. Created either solo (on a first sign-in with no
/// invite) or joined via a HouseholdInvite.
model Household {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// The month the budget begins; months before it are hidden from the stepper.
  /// Household-level rather than per-person on purpose: the two budgets are
  /// separate, but the household started keeping one on a single date, and two
  /// different back-stops would be a distinction without a difference.
  /// 1-based month, like everywhere else in this app. Null = no bound yet.
  budgetStartYear  Int?
  budgetStartMonth Int?

  members       User[]
  invites       HouseholdInvite[]
  budgetNodes   BudgetNode[]
  incomeSources IncomeSource[]
  transactions  Transaction[]
  plaidItems    PlaidItem[]
  settlements   Settlement[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  /// Palette slug from src/lib/members.ts — the basis for every "whose is
  /// whose" badge in the app. Assigned at household creation (first member) or
  /// at join (second member takes the free slot); stable thereafter.
  color     String
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdInvites  HouseholdInvite[] @relation("CreatedBy")
  acceptedInvites HouseholdInvite[] @relation("AcceptedBy")

  budgetNodes      BudgetNode[]
  incomeSources    IncomeSource[]
  paidTransactions Transaction[]
  plaidItems       PlaidItem[]
  settlementsPaid     Settlement[] @relation("SettlementsPaid")
  settlementsReceived Settlement[] @relation("SettlementsReceived")

  @@index([householdId])
}

/// One linked bank login (a Plaid Item). `accessToken` is the long-lived Plaid
/// credential; `cursor` is the /transactions/sync position — null means "never
/// synced", which is what makes the first sync a full backfill and every later
/// one a delta.
model PlaidItem {
  id              String    @id @default(cuid())
  /// Plaid's item_id.
  itemId          String    @unique
  accessToken     String
  institutionName String
  cursor          String?
  createdAt       DateTime  @default(now())
  lastSyncedAt    DateTime?
  /// Linked for balances/holdings only — its institution has no transactions
  /// product (brokerages typically don't). Excluded from syncPlaidTransactions,
  /// which would otherwise throw for the whole household on this item.
  investmentsOnly Boolean   @default(false)

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Who pays from this connection. null = joint account, matching Transaction.ownerId.
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  accounts PlaidAccount[]

  @@index([householdId])
}

/// A mirror of one account inside a PlaidItem, refreshed from every sync's
/// `accounts` payload. Deliberately dumb: nothing user-authored lives here, so it
/// can be overwritten wholesale. The Cards feature gets its own model pointing at
/// this one, so unlinked cards still work.
///
/// No `householdId` — unlike every other model, this one scopes through `item`.
/// It is derived from the item, so a column here could only ever drift from it,
/// and `migrateHouseholdRecords()` needs no line for it: moving the item moves
/// its accounts.
model PlaidAccount {
  id             String  @id @default(cuid())
  /// Plaid's account_id. The dedup key for the sync upsert.
  plaidAccountId String  @unique
  name           String
  /// Last 4. Nullable — Plaid omits it for some institutions.
  mask           String?
  /// "credit" | "depository" | ... and its subtype ("credit card", "checking").
  /// The only signal for which accounts are actually cards.
  type           String
  subtype        String?

  itemId String
  item   PlaidItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@index([itemId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
}

/// Single-use, never expires. Consumed by flipping status PENDING -> ACCEPTED
/// with a conditional update, which is what makes "single use" race-safe.
model HouseholdInvite {
  id          String    @id @default(cuid())
  code        String    @unique
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdByUserId String
  createdBy       User   @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  status           InviteStatus @default(PENDING)
  acceptedByUserId String?
  acceptedBy       User?        @relation("AcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([householdId])
  @@index([createdByUserId])
}

/// One node of a person's budget tree: a group, a category, or a line item —
/// the same model at three depths. Depth is capped at 2 by `addBudgetNode`; the
/// database does not enforce it.
///
/// The rule that governs the whole feature, and the reason this is one model
/// rather than three: **a node with children derives its budget and spend from
/// them; a leaf holds its own.** `buildBudgetTree` in src/lib/budget.ts is the
/// single implementation.
///
/// Like the Budget it replaces, `ownerId` is required rather than nullable:
/// there are no joint nodes. Each person's budget is entirely their own, and a
/// shared cost is handled by splitting the transaction across both people's
/// nodes. `householdId` remains the query scope — either member can read and
/// edit the other's tree.
model BudgetNode {
  id          String   @id @default(cuid())
  label       String
  /// Icon slug resolved by CatGlyph; unknown slugs fall back to a banknote.
  icon        String
  position    Int
  /// The rolling default, used for any month with no BudgetNodeMonth override.
  budget      Decimal  @default(0) @db.Decimal(10, 2)
  /// Set = this is a savings node, which draws a year-to-date bar against the
  /// limit. There is no SavingsAccount model: savings is a shape, not a table.
  annualLimit Decimal? @db.Decimal(10, 2)
  /// Marks a savings subtree: set on a group, descendants inherit it (see
  /// `savingsNodeIds`). A savings node's spend is a typed transfer, not derived
  /// from transactions, and it drops out of `budgetLeaves` — nothing can be filed
  /// into it.
  isSavings   Boolean  @default(false)
  /// Unspent budget accrues forward instead of evaporating at month end — for
  /// lumpy categories (travel, gifts) that sit near zero then take one big hit.
  /// Unlike `isSavings` this is NOT inherited: it is set per node.
  rollsOver   Boolean  @default(false)
  createdAt   DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  parentId String?
  parent   BudgetNode?  @relation("BudgetNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children BudgetNode[] @relation("BudgetNodeTree")

  months BudgetNodeMonth[]
  splits TransactionSplit[]

  @@index([householdId, ownerId, position])
  @@index([parentId])
}

/// A per-month override of `BudgetNode.budget`, and/or a savings node's typed
/// transfer for the month. Absent `budget` means "use the rolling default",
/// which is what keeps a budget you set once applying to every future month
/// while last March stays exactly as it was.
model BudgetNodeMonth {
  id     String     @id @default(cuid())
  nodeId String
  node   BudgetNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  year   Int
  /// 1-based, like every other month in this app.
  month       Int
  /// Nullable so a contribution-only write doesn't freeze this month's budget at
  /// whatever the rolling default happened to be.
  budget      Decimal? @db.Decimal(10, 2)
  /// A savings node's manually entered transfer for this month. Only meaningful
  /// on a savings node, where it *replaces* derived spend rather than adding to
  /// it — see `BudgetNode.isSavings`.
  contributed Decimal? @db.Decimal(10, 2)

  @@unique([nodeId, year, month])
}

/// Net monthly income, per person. `sub` is the grey second line ("Net, monthly").
///
/// No month dimension: income is a standing figure, edited when it changes,
/// rather than re-entered twelve times a year.
model IncomeSource {
  id       String  @id @default(cuid())
  label    String
  sub      String?
  amount   Decimal @default(0) @db.Decimal(10, 2)
  position Int

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([householdId, ownerId, position])
}

/// A single real-world charge. Spend is never stored on a Budget — it is derived
/// by summing the splits below, which makes this table the only source of truth
/// and rules out the two writers disagreeing.
model Transaction {
  id        String   @id @default(cuid())
  merchant  String
  /// Date-only. Always read and write through `monthRange` in src/lib/budget.ts:
  /// local date getters slip a month at the boundary.
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())
  /// Plaid's transaction_id. Set = came from a sync, and the dedup key for it.
  /// Null for hand-entered rows.
  plaidTransactionId String? @unique
  /// The split decision: null = not decided yet, false = all on the payer,
  /// true = halved with the other household member. A transaction is "filed"
  /// only once this is set AND splits exist — splits alone (the pre-inbox
  /// shape) no longer count, since they can't tell "don't split" from "haven't decided".
  shared    Boolean?

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Who paid. null = a joint account, so nobody is owed. Pure attribution — it
  /// has no bearing on which budget the money lands in, that is the splits' job.
  ownerId     String?
  owner       User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  /// Which account it was charged to. Null for hand-entered rows. SetNull, not
  /// Cascade — unlinking a bank must not delete spend history.
  accountId String?
  account   PlaidAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  splits TransactionSplit[]

  @@index([householdId, date])
}

/// One share of a transaction, filed against exactly one budget node.
///
/// This is the only place the two people's budgets meet: a shared cost is one
/// transaction split across a node of each person's tree.
///
/// Invariant: a transaction has either zero splits (unfiled — it counts against
/// no budget) or splits summing exactly to its amount. Enforced in
/// `validateSplits`, and `setTransactionSplits` is the only way to write these.
/// Splits may only target *leaf* nodes; filing against a parent would be counted
/// twice, once on its own and once through the roll-up.
///
/// No `householdId` of its own: a child row is always reached through its
/// transaction, which carries the scope, and is cascade-deleted with it.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Named `budgetId` rather than `nodeId` because it is what it always was —
  /// the budget this share counts against. Only the target model changed.
  ///
  /// Restrict, not Cascade: cascading would delete some of a transaction's splits
  /// and leave the survivors summing to less than its amount. `deleteBudgetNode`
  /// refuses while splits reference anything in the subtree instead — it has to
  /// check the whole subtree, because deleting a group cascades to its children
  /// and Postgres would then raise the violation from a row nobody named.
  budgetId      String
  budget        BudgetNode  @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  amount        Decimal     @db.Decimal(10, 2)

  @@index([transactionId])
  @@index([budgetId])
}

/// A real payback between the two members — the one fact the splits can't derive.
///
/// Deliberately not tied to any transaction: it settles the running balance, not a
/// specific charge. `date` is `@db.Date` like Transaction, so read it through
/// `monthRange`/`parseDateOnly` for the same reason (local getters slip a month).
///
/// No `ownerId`: `fromUserId`/`toUserId` already say whose money moved, and the
/// attribution convention doesn't apply to a two-sided transfer.
model Settlement {
  id        String   @id @default(cuid())
  /// Who paid the money back.
  fromUserId String
  from      User     @relation("SettlementsPaid", fields: [fromUserId], references: [id], onDelete: Cascade)
  /// Who received it.
  toUserId  String
  to        User     @relation("SettlementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, date])
}
