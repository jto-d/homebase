# Copy to .env and fill in. Key names only — never commit values.

# Neon connection strings.
# Pooled ("-pooler" in the hostname) — used by the app at runtime via @prisma/adapter-neon.
DATABASE_URL=
# Direct (unpooled) — required by Prisma Migrate, read via prisma.config.ts.
DIRECT_URL=

# Auth.js v5. Generate the secret with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth client. Authorized redirect URIs must include
# http://localhost:3000/api/auth/callback/google for local development.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Base URL used to build shareable invite links (https://homebase.jtod.dev in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000
